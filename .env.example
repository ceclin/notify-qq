QQ_APP_ID=
QQ_APP_SECRET=
LISTEN_ADDR=127.0.0.1:8080
# Optional literal URL path, for example /api/notify-qq. Empty or / serves at root.
API_PATH_PREFIX=
DATA_DIR=./data
LOG_LEVEL=info
# Set an OTLP/HTTP base URL to enable traces and metrics, for example http://localhost:4318.
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_SERVICE_NAME=notify-qq
# Parent-based trace sampling; 0-1 controls new traces, while parent decisions are honored.
OTEL_TRACES_SAMPLER_ARG=1
# Optional comma-separated name=value pairs; percent-encode special characters in values.
OTEL_EXPORTER_OTLP_HEADERS=
